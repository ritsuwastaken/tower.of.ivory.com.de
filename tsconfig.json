{
  "extends": "@tsconfig/next/tsconfig.json",
  "compilerOptions": {
    "target": "es2020",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*",
    "oxlint.config.mts"
  ],
  "exclude": ["node_modules"]
}
