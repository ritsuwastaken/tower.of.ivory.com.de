{
  "name": "tower.of.ivory.com.de",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged --concurrent false && npm run types:check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --fix .",
    "format": "prettier . --write",
    "lint:check": "oxlint --type-aware .",
    "format:check": "prettier . --check",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "^26.5.11",
    "next": "^16.5.0-canary.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tsconfig/next": "^2.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
