{
  "name": "tower.of.ivory.com.de",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged --concurrent false && npm run types:check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix .",
    "format": "prettier . --write",
    "lint:check": "eslint .",
    "format:check": "prettier . --check",
    "types:check": "tsc --noEmit"
  },
  "overrides": {
    "eslint": "^10.13.0"
  },
  "dependencies": {
    "i18next": "^26.5.11",
    "next": "^16.5.0-canary.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tsconfig/next": "^2.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.5.0-canary.31",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
